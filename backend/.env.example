# Bingwa AI — Environment Variables
# Copy this to .env and fill in values. Never commit .env

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
# Port 5433 avoids conflict with any local PostgreSQL installation (Docker maps 5433→5432 in container)
DATABASE_URL=postgresql://bingwa:localonly@localhost:5433/bingwa_ai

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
NLP_MODEL=claude-sonnet-4-5
NLP_MAX_TOKENS=500

# WhatsApp provider
#   meta      = Meta Cloud API fallback during transition
#   360dialog = DECIDED BSP; payloads stay Cloud API-compatible
WA_PROVIDER=meta

# WhatsApp (Meta Cloud API; required when WA_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=bingwa-webhook-verify-2026
WHATSAPP_BUSINESS_ACCOUNT_ID=

# WhatsApp (360dialog; required when WA_PROVIDER=360dialog)
D360_API_KEY=
D360_BASE_URL=https://waba-v2.360dialog.io
# HTTP Basic auth credential configured at webhook registration: user:password
D360_WEBHOOK_SECRET=

# ── Payment provider selection (WP-25b) ──────────────────────────────────────
# Xente is the SOLE provider (WP-25 / WP-25b). Legacy direct MTN/Airtel clients
# and Flutterwave have been REMOVED. Any other value is fatal at startup.
PAYMENT_PROVIDER=xente

# ── Xente (required) — WP-25 / WP-25b ────────────────────────────────────────
# Auth: POST /api/auth/login {appKey, appPassword, userId} → 60-min bearer token
# (cached in-process; never logged). NOTE: Xente also requires OUR egress IP to
# be whitelisted in their portal, or auth calls fail — see wp-18-cutover.md.
XENTE_BASE_URL=https://api.xente.co
XENTE_APP_KEY=
XENTE_APP_PASSWORD=
XENTE_USER_ID=
# IPN security: Xente sends NO signature. Their IPN is authenticated by
# (a) source-IP allowlist — Xente's published IPN egress IPs, comma-separated —
# and (b) a static secret path token on the callback URL:
#   POST /api/payments/xente/callback/<XENTE_IPN_PATH_TOKEN>
# Register that FULL URL (including the token) in the Xente portal.
# Generate the token: openssl rand -hex 24
XENTE_IPN_ALLOWED_IPS=52.48.24.237,34.252.29.119
XENTE_IPN_PATH_TOKEN=
# Optional: mobile-money product item ids (defaults baked in; override if
# Xente's catalogue names differ for your account).
#XENTE_MTN_ITEM_ID=MTNMOBILEMONEYUG_MTNMOBILEMONEYUG
#XENTE_AIRTEL_ITEM_ID=AIRTELMONEYUG_AIRTELMONEYUG

# ── Weekly encrypted database backup (WP-15) ─────────────────────────────────
# pg_dump -Fc (OWNER connection) → openssl aes-256-cbc -pbkdf2 -salt → S3.
# Scheduled: Sunday 03:00 EAT. Script: backend/scripts/backup.ts.
# Restore runbook: docs/runbooks/restore.md
# Retention: ≥7 years enforced via S3 lifecycle + Object Lock (WORM).
#           The backup script is append-only — it has NO delete/overwrite path.
#
# Container deps (Railway/prod): postgresql-client-15 + openssl must be
# installed in the deploy image. Node base image has neither.
#   apt-get update && apt-get install -y postgresql-client-15 openssl

# AES-256 encryption key for backup artifacts. Generate once, store in secrets
# manager, never commit or log. Example keygen: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=

# S3-compatible object storage (AWS S3, MinIO, DigitalOcean Spaces, etc.)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=gezi-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto

# Set to "true" for local dev/testing — skips S3 upload, only produces encrypted artifact
BACKUP_SKIP_S3=

# Logging
LOG_LEVEL=debug  # debug | info | warn | error

# Scheduled jobs timezone
TZ=Africa/Kampala

# Backup heartbeat alerts (WP-31 dead-man's-switch, Monday 09:00 EAT)
ALERT_WHATSAPP_PHONE=        # +256XXXXXXXXX ops phone; alert sent via 360dialog template
ALERT_WHATSAPP_TEMPLATE=ops_alert  # approved template name (1 body param: reason)
ALERT_EMAIL=                 # ops email; stub-logged until an SMTP provider is wired
