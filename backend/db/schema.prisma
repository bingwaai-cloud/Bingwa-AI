generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Global schema tables ──────────────────────────────────────────────────
// These live in the public schema and are shared across all tenants.
// Per-tenant tables (items, sales, purchases, etc.) are created dynamically
// in each tenant's own schema (tenant_{uuid}) when they sign up.

model Tenant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName       String    @db.VarChar(255)
  businessType       String?   @db.VarChar(100)
  ownerName          String    @db.VarChar(255)
  ownerPhone         String    @unique @db.VarChar(20)
  schemaName         String    @unique @db.VarChar(100)
  country            String    @default("UG") @db.VarChar(10)
  currency           String    @default("UGX") @db.VarChar(10)
  timezone           String    @default("Africa/Kampala") @db.VarChar(50)
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @db.Timestamptz()
  deletedAt          DateTime? @db.Timestamptz()

  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]
  platformSuppliers   PlatformSupplier[]

  @@map("tenants")
}

model Subscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  plan          String    @default("free") @db.VarChar(20)
  status        String    @default("active") @db.VarChar(20)
  amountUgx     Int       @default(0)
  startedAt     DateTime  @default(now()) @db.Timestamptz()
  expiresAt     DateTime? @db.Timestamptz()
  paymentMethod String?   @db.VarChar(20)
  paymentPhone  String?   @db.VarChar(20)
  createdAt     DateTime  @default(now()) @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("subscriptions")
}

model PaymentTransaction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @db.Uuid
  provider          String   @db.VarChar(20)
  providerReference String?  @db.VarChar(255)
  amountUgx         Int
  status            String   @default("pending") @db.VarChar(20)
  type              String   @db.VarChar(20)
  phone             String   @db.VarChar(20)
  createdAt         DateTime @default(now()) @db.Timestamptz()
  updatedAt         DateTime @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("payment_transactions")
}

model PlatformSupplier {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @db.Uuid
  name       String   @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  location   String?  @db.VarChar(255)
  categories String[]
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz()
  updatedAt  DateTime @updatedAt @db.Timestamptz()

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("platform_suppliers")
}

// ─── Per-tenant tables (row-level multi-tenancy — P0-1) ─────────────────────
// Consolidated out of the per-tenant tenant_{uuid} schemas into the public
// schema, keyed by tenantId. DDL source of truth: db/migrations/004_consolidate_tenants.sql.
// tenantId is a scalar (no Tenant relation) by design: tenant scoping is enforced
// by withTenant()/RLS, not by ORM navigation. FK to tenants(id) is declared in 004 SQL.

model Item {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(255)
  nameNormalized    String    @map("name_normalized") @db.VarChar(255)
  aliases           String[]
  unit              String    @default("piece") @db.VarChar(50)
  qtyInStock        Int       @default(0) @map("qty_in_stock")
  lowStockThreshold Int       @default(5) @map("low_stock_threshold")
  typicalBuyPrice   Int?      @map("typical_buy_price")
  typicalSellPrice  Int?      @map("typical_sell_price")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, nameNormalized])
  @@index([tenantId, createdAt])
  @@map("items")
}

model Sale {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  itemName    String    @map("item_name") @db.VarChar(255)
  qty         Int
  unitPrice   Int       @map("unit_price")
  totalPrice  Int       @map("total_price")
  customerId  String?   @map("customer_id") @db.Uuid
  recordedBy  String?   @map("recorded_by") @db.VarChar(20)
  source      String    @default("whatsapp") @db.VarChar(20)
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@index([itemId])
  @@index([customerId])
  @@map("sales")
}

model SaleLineItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  saleId      String    @map("sale_id") @db.Uuid
  itemId      String?   @map("item_id") @db.Uuid
  itemName    String    @map("item_name") @db.VarChar(255)
  qty         Int
  unit        String    @default("piece") @db.VarChar(50)
  unitPrice   Int       @map("unit_price")
  totalPrice  Int       @map("total_price")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@index([saleId])
  @@index([itemId])
  @@map("sale_line_items")
}

model Purchase {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  itemId       String?   @map("item_id") @db.Uuid
  itemName     String    @map("item_name") @db.VarChar(255)
  qty          Int
  unitPrice    Int       @map("unit_price")
  totalPrice   Int       @map("total_price")
  supplierId   String?   @map("supplier_id") @db.Uuid
  supplierName String?   @map("supplier_name") @db.VarChar(255)
  recordedBy   String?   @map("recorded_by") @db.VarChar(20)
  source       String    @default("whatsapp") @db.VarChar(20)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@index([itemId])
  @@index([supplierId])
  @@map("purchases")
}

model PriceHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  itemId          String?  @map("item_id") @db.Uuid
  transactionType String   @map("transaction_type") @db.VarChar(10)
  unitPrice       Int      @map("unit_price")
  totalPrice      Int      @map("total_price")
  qty             Int
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz()

  @@index([itemId, recordedAt])
  @@index([tenantId, recordedAt])
  @@map("price_history")
}

model Supplier {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  platformSupplierId String?   @map("platform_supplier_id") @db.Uuid
  name               String    @db.VarChar(255)
  phone              String?   @db.VarChar(20)
  location           String?   @db.VarChar(255)
  itemsSupplied      String[]  @map("items_supplied")
  notes              String?
  reliabilityScore   Int       @default(5) @map("reliability_score")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId])
  @@index([platformSupplierId])
  @@map("suppliers")
}

model Customer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  phone             String?   @db.VarChar(20)
  name              String?   @db.VarChar(255)
  totalPurchases    Int       @default(0) @map("total_purchases")
  visitCount        Int       @default(0) @map("visit_count")
  lastVisitedAt     DateTime? @map("last_visited_at") @db.Timestamptz()
  optedInMarketing  Boolean   @default(true) @map("opted_in_marketing")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, phone])
  @@map("customers")
}

model Expense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  amountUgx   Int       @map("amount_ugx")
  frequency   String    @default("monthly") @db.VarChar(20)
  dueDay      Int?      @map("due_day")
  lastPaidAt  DateTime? @map("last_paid_at") @db.Timestamptz()
  nextDueAt   DateTime? @map("next_due_at") @db.Timestamptz()
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@map("expenses")
}

model UserContext {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  userPhone          String   @map("user_phone") @db.VarChar(20)
  interactionLog     Json     @default("[]") @map("interaction_log")
  onboardingStep     Int      @default(0) @map("onboarding_step")
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  preferences        Json     @default("{}")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([tenantId, userPhone])
  @@index([tenantId, userPhone])
  @@map("user_context")
}

model Receipt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  receiptNumber Int      @default(autoincrement()) @map("receipt_number")
  saleId        String?  @map("sale_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  items         Json
  totalUgx      Int      @map("total_ugx")
  cashReceived  Int?     @map("cash_received")
  changeGiven   Int?     @map("change_given")
  printed       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@index([saleId])
  @@map("receipts")
}

model MarketingBroadcast {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  message   String
  sentTo    Int       @default(0) @map("sent_to")
  delivered Int       @default(0)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz()
  createdBy String?   @map("created_by") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@map("marketing_broadcasts")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userPhone    String?  @map("user_phone") @db.VarChar(20)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  entityType   String?  @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.Uuid
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  source       String?  @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  phone                 String    @db.VarChar(20)
  name                  String?   @db.VarChar(255)
  role                  String    @default("cashier") @db.VarChar(20)
  passwordHash          String?   @map("password_hash") @db.VarChar(255)
  refreshTokenHash      String?   @map("refresh_token_hash") @db.VarChar(500)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz()
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz()
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId])
  @@map("users")
}

model ItemAlias {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  alias            String    @db.Text
  itemId           String    @map("item_id") @db.Uuid
  confirmedCount   Int       @default(1) @map("confirmed_count")
  isGlobal         Boolean   @default(false) @map("is_global")
  globalPromotedAt DateTime? @map("global_promoted_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, alias])
  @@index([itemId])
  @@map("item_aliases")
}

model DraftTransaction {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userPhone             String    @map("user_phone") @db.VarChar(20)
  action                String    @db.VarChar(50)
  payload               Json
  state                 String    @db.VarChar(30)
  clarificationQuestion String?   @map("clarification_question")
  committedEntityId     String?   @map("committed_entity_id") @db.Uuid
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz()
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, userPhone, state])
  @@index([tenantId, createdAt])
  @@map("draft_transactions")
}

model UnknownMessage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  message      String    @db.Text
  rawNlpOutput Json?     @map("raw_nlp_output")
  source       String    @default("whatsapp") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewAction String?   @map("review_action") @db.VarChar(30)
  corpusCaseId String?   @map("corpus_case_id") @db.VarChar(50)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("unknown_messages")
}
